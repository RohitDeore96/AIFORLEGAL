# LegalLens AI — environment variables template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# ─── Database ─────────────────────────────────────────────────────────────
# Local dev: SQLite file path
# Vercel prod: Neon Postgres URL (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=file:./dev.db

# ─── NextAuth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (no trailing slash)
# Local dev: http://localhost:3000
# Vercel prod: https://your-project.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Set to "true" to allow sign-up via the sign-in form (auto-creates user on first sign-in).
# Set to "false" in production if you want separate sign-up logic.
ALLOW_SIGNUP_VIA_SIGNIN=true

# ─── AI Provider ───────────────────────────────────────────────────────────
# One of: "gemini" (production), "zai" (sandbox), "mock" (demo / tests)
# If left empty, defaults to "gemini" when GOOGLE_GEMINI_API_KEY is set, else "mock"
AI_PROVIDER=mock

# Google Gemini API key — required when AI_PROVIDER=gemini
# Get one at https://aistudio.google.com/apikey (free tier available)
GOOGLE_GEMINI_API_KEY=

# Model name — see https://ai.google.dev/models for options
GEMINI_MODEL=gemini-1.5-flash

# ─── File Storage ─────────────────────────────────────────────────────────
# Where uploaded files are stored (filesystem). Swap for Vercel Blob in production.
STORAGE_DIR=./.storage

# ─── Upload Limits ─────────────────────────────────────────────────────────
# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_BYTES=10485760

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─── Rate Limiting ─────────────────────────────────────────────────────────
# Per-user AI request limit per minute
AI_RATE_LIMIT_PER_MIN=10

# ─── Runtime ──────────────────────────────────────────────────────────────
# Set to "production" for deployed environments
NODE_ENV=development
