# npm configuration
# Next.js 16 + next-auth v4 have a peer dependency conflict (next-auth v4
# declares support only for Next 12-15). Vercel uses `npm install` which is
# strict about peer deps. `legacy-peer-deps=true` tells npm to use the older
# (npm v6) resolution algorithm that just warns on peer conflicts instead of
# failing the install. This is the recommended workaround per the next-auth
# maintainers until next-auth v5 goes stable.
#
# Ref: https://github.com/nextauthjs/next-auth/discussions/9493
legacy-peer-deps=true

# Stricter install behavior — fail fast if lockfile is out of sync.
fund=false
audit=false
